{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E Tests with AI Capabilities incl MCP",
  "keywords": [
    "Playwright",
    "e2e",
    "MCP"
  ],
  "license": "ISC",
  "author": "Osman",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "demo:params": "npx playwright test tests/demo/params.make.appmnt.spec.ts --headed",
    "qa:make-apt": "npx playwright test --config=config/qa.playwright.config.ts tests/functional/make.appmnt.spec.ts --headed",
    "dev:make-apt": "npx playwright test --config=config/dev.playwright.config.ts tests/functional/make.appmnt.spec.ts --headed",
    "demo:parallel": "npx playwright test --grep @demo",
    "pw-adv-cap": "npx playwright test tests/demo/pw.adv.cap.login.spec.ts --headed",
    "demo:tag": "npx playwright test --grep @smoke --headed",
    "login": "npx playwright test tests/functional/login.spec.ts --headed",
    "demo:global": "npx playwright test tests/functional/login.spec.ts",
    "demo": "npx playwright test tests/demo/mytest.spec.ts --headed",
    "pw-basic-cap": "npx playwright test tests/demo/pw.basic.cap.appmnt.spec.ts --headed",
    "screenshots": "npx playwright test tests/demo/screenshot.appmnt.spec.ts --headed",
    "make-apt": "npx playwright test tests/functional/make.appmnt.spec.ts --headed",
    "make-apt-debug": "npx playwright test tests/demo/debug.make.appmnt.spec.ts --headed",
    "debug:ui": "npx playwright test tests/demo/debug.make.appmnt.spec.ts --ui --headed",
    "debug:trace": "npx playwright test tests/demo/debug.make.appmnt.spec.ts --trace on",
    "debug:cli": "npx playwright test tests/demo/debug.make.appmnt.spec.ts --debug",
    "elementInteraction": "npx playwright test tests/demo/element.handling.make.appmnt.spec.ts --headed",
    "elementDropdown": "npx playwright test tests/demo/element.handling.dropdown.spec.ts --headed",
    "elementRadioButton": "npx playwright test tests/demo/element.handling.radioButton.spec.ts --headed",
    "Inventory": "npx playwright test tests/functional/inventory.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "^3.13.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
